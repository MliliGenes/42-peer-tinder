generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OAuthAttempt {
  id               String   @id @default(cuid())
  provider         String   @default("FORTYTWO")
  purpose          String   @default("LOGIN")
  stateHash        String   @unique
  browserNonceHash String
  returnPath       String   @default("/")
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([expiresAt])
  @@index([provider, purpose, consumedAt])
}

model User {
  id                String    @id @default(cuid())
  fortyTwoId        String    @unique
  login             String
  displayName       String
  avatarUrl         String?
  bio               String    @default("")
  eligibleCursusId  Int
  visible           Boolean   @default(false)
  onboardedAt       DateTime?
  suspendedAt       DateTime?
  deletionRequestedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  intentions        SearchIntent[]
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  csrfTokenHash  String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Project {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  providerProjectId String?       @unique
  enabled           Boolean       @default(true)
  createdAt         DateTime      @default(now())
  intentions        SearchIntent[]
}

model SearchIntent {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  scopeKey    String
  purpose     String
  active      Boolean  @default(true)
  schedule    String   @default("ANY")
  timeZone    String   @default("UTC")
  goal        String?
  confirmedAt DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, scopeKey, purpose])
  @@index([userId, active, expiresAt])
  @@index([purpose, scopeKey, active, expiresAt])
}
